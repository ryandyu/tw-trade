<configuration debug="true">

	<contextName>${sumridge.metaproject}/${sumridge.project}/${sumridge.release}
	</contextName>

	<appender name="FileAppender" class="ch.qos.logback.core.FileAppender">
		<file>${rootDir}/logs/${appid}.log </file>
		<layout class="ch.qos.logback.classic.PatternLayout">
			<pattern>[%-5p] %d{MM/dd/yyyy HH:mm:ss.SSS} %p %c - %m%n</pattern>
		</layout>
	</appender>
	
	<appender name="FixFileAppender" class="ch.qos.logback.core.FileAppender">
		<file>${rootDir}/logs2/${appid}.log </file>
		<layout class="ch.qos.logback.classic.PatternLayout">
			<pattern>[%-5p] %d{MM/dd/yyyy HH:mm:ss.SSS} %p %c - %m%n</pattern>
		</layout>
	</appender>

	<appender name="ConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
		<layout class="ch.qos.logback.classic.PatternLayout">
			<pattern>[%-5p] %d{MM/dd/yyyy HH:mm:ss} %p %c - %m%n</pattern>
		</layout>
	</appender>
	
	<logger name="com.sumridge.saxm.lib.FisQueue" additivity="false">
		<level value="info" />
		<appender-ref ref="ConsoleAppender" />
		<appender-ref ref="FileAppender" />
	</logger>

	<logger name="quickfixj.msg" additivity="false">
    	<level value="info" />
		<appender-ref ref="ConsoleAppender" />
		<appender-ref ref="FixFileAppender" />
    </logger>
    <logger name="quickfixj.event" additivity="false">
    	<level value="info" />
		<appender-ref ref="ConsoleAppender" />
		<appender-ref ref="FixFileAppender" />
		<appender-ref ref="FileAppender" />
    </logger>

	<root>
		<level value="info" />
		<appender-ref ref="ConsoleAppender" />
		<appender-ref ref="FileAppender" />
	</root>
</configuration>
